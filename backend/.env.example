POSTGRES_DB=tessera
POSTGRES_USER=tessera_bootstrap
POSTGRES_PASSWORD=replace-with-random-bootstrap-password
TESSERA_RUNTIME_PASSWORD=replace-with-random-runtime-password
TESSERA_MIGRATOR_PASSWORD=replace-with-random-migrator-password
DATABASE_URL=postgres://tessera_runtime_login:replace-with-random-runtime-password@db:5432/tessera
MIGRATION_DATABASE_URL=postgres://tessera_migrator_login:replace-with-random-migrator-password@db:5432/tessera
JEV_API_KEY=
JEV_MAX_REQUESTS=1000
DEMO_PASSWORD=replace-with-long-demo-password
# Optional demo identities; each must be distinct and at least 12 characters.
DEMO_CSM_PASSWORD=
DEMO_USER_PASSWORD=
SESSION_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_ORIGIN=https://demo.example
API_PORT=8080
FRONTEND_PORT=3000
